      "#edit-save-btn",
      "form[action$=\"/internal-note\"] button[type=\"submit\"]",
      "#dropship_enabled",
      "main a[href=\"/exports/csv\"]",
      "main a[href=\"/exports/images\"]"
    ],
    "disposableEnvironmentMarker": "#test-env-banner"
  }
