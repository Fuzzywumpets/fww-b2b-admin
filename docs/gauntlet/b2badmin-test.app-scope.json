          "value": "Gauntlet internal note"
        },
        {
          "action": "click",
          "selector": "form[action$=\"/internal-note\"] button[type=\"submit\"]"
        },
        {
          "action": "assert_visible_text",
          "text": "Note saved.",
          "requirementIds": [
            "REQ-INTERNAL-NOTE"
          ]
        }
      ]
    },
